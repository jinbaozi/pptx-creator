{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/run.schema.json",
  "title": "Generation Run Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "mode", "status", "input", "artifacts"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["creative", "direct", "replica", "hybrid"] },
    "status": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "required": ["type", "summary"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckPlan", "semanticIr", "manifest", "pptx", "previews", "reviews", "consistencyReport", "sources", "assetRegistry", "creativeCandidates", "creativeSelection", "blindPacket", "creativeProof", "creativeProofEvidence", "hostVisualReview"],
      "properties": {
        "deckPlan": { "type": ["string", "null"] },
        "semanticIr": { "type": ["string", "null"] },
        "manifest": { "type": ["string", "null"] },
        "pptx": { "type": ["string", "null"] },
        "previews": { "type": "array", "items": { "type": "string" } },
        "reviews": { "type": "array", "items": { "type": "string" } },
        "consistencyReport": { "type": ["string", "null"] },
        "sources": { "type": ["string", "null"] },
        "assetRegistry": { "type": ["string", "null"] },
        "creativeCandidates": { "type": ["string", "null"] },
        "creativeSelection": { "type": ["string", "null"] },
        "blindPacket": { "type": ["string", "null"] },
        "creativeProof": { "type": ["string", "null"] },
        "creativeProofEvidence": { "type": ["string", "null"] },
        "hostVisualReview": { "type": ["string", "null"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explorationId", "blindPacketHash", "selectedCandidateId"],
      "properties": {
        "explorationId": { "type": "string", "pattern": "^explore-[a-f0-9]{24}$" },
        "blindPacketHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "selectedCandidateId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
