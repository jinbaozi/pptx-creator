{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/schemas/blind-preference.schema.json",
  "title": "Creative benchmark blind-preference report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "packetHash", "sample", "overall", "subgroups", "medians", "thresholds", "failures"],
  "properties": {
    "version": { "const": "0.1.0" },
    "status": { "enum": ["passed", "unproven"] },
    "packetHash": { "type": "string", "pattern": "^sha256:(?:[a-f0-9]{64}|missing)$" },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefs", "reviews", "reviewersPerBrief"],
      "properties": {
        "briefs": { "type": "integer", "minimum": 0 },
        "reviews": { "type": "integer", "minimum": 0 },
        "reviewersPerBrief": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "required"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "required": { "const": 5 }
          }
        }
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wins", "reviews", "winRate", "wilson95LowerBound"],
      "properties": {
        "wins": { "type": "integer", "minimum": 0 },
        "reviews": { "type": "integer", "minimum": 0 },
        "winRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "wilson95LowerBound": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "subgroups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "language"],
      "properties": {
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executive", "technical", "product-launch", "data-review", "public-sector", "editorial-education"],
          "properties": {
            "executive": { "$ref": "#/$defs/subgroup" },
            "technical": { "$ref": "#/$defs/subgroup" },
            "product-launch": { "$ref": "#/$defs/subgroup" },
            "data-review": { "$ref": "#/$defs/subgroup" },
            "public-sector": { "$ref": "#/$defs/subgroup" },
            "editorial-education": { "$ref": "#/$defs/subgroup" }
          }
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en-US", "zh-CN"],
          "properties": {
            "en-US": { "$ref": "#/$defs/subgroup" },
            "zh-CN": { "$ref": "#/$defs/subgroup" }
          }
        }
      }
    },
    "medians": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "spacing", "density", "consistency", "originality"],
      "properties": {
        "hierarchy": { "$ref": "#/$defs/rating" },
        "spacing": { "$ref": "#/$defs/rating" },
        "density": { "$ref": "#/$defs/rating" },
        "consistency": { "$ref": "#/$defs/rating" },
        "originality": { "$ref": "#/$defs/rating" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefs", "reviewersPerBrief", "totalWinRate", "wilson95LowerBound", "subgroupWinRate", "medianRating"],
      "properties": {
        "briefs": { "const": 24 },
        "reviewersPerBrief": { "const": 5 },
        "totalWinRate": { "const": 0.7 },
        "wilson95LowerBound": { "const": 0.5 },
        "subgroupWinRate": { "const": 0.6 },
        "medianRating": { "const": 4 }
      }
    },
    "failures": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pairId", "reviewerId", "selected", "ratings", "submittedAt"],
      "properties": {
        "version": { "const": "0.1.0" },
        "pairId": { "type": "string", "pattern": "^pair-[a-f0-9]{12}$" },
        "reviewerId": { "type": "string", "minLength": 1 },
        "selected": { "enum": ["left", "right", "tie"] },
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/sideRatings" },
            "right": { "$ref": "#/$defs/sideRatings" }
          }
        },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "sideRatings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "spacing", "density", "consistency", "originality"],
      "properties": {
        "hierarchy": { "type": "integer", "minimum": 1, "maximum": 5 },
        "spacing": { "type": "integer", "minimum": 1, "maximum": 5 },
        "density": { "type": "integer", "minimum": 1, "maximum": 5 },
        "consistency": { "type": "integer", "minimum": 1, "maximum": 5 },
        "originality": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "subgroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviews", "wins", "winRate"],
      "properties": {
        "reviews": { "type": "integer", "minimum": 0 },
        "wins": { "type": "integer", "minimum": 0 },
        "winRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 }
  }
}
