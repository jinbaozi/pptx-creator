{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/refinement-state.schema.json",
  "title": "Protected creative refinement resume state",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baseRunHash", "sourceProofHash", "approvedOperations", "pendingApproval", "attemptBudget", "bestIdentity", "reviewBindings", "signatureMoment", "hostApproval"],
  "properties": {
    "version": { "const": "0.1.0" },
    "baseRunHash": { "$ref": "#/$defs/hash" },
    "sourceProofHash": { "$ref": "#/$defs/hash" },
    "approvedOperations": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/operation" } },
    "pendingApproval": { "$ref": "#/$defs/operation" },
    "attemptBudget": { "$ref": "#/$defs/budget" },
    "bestIdentity": { "$ref": "#/$defs/bestIdentity" },
    "reviewBindings": { "type": "array", "items": { "$ref": "#/$defs/reviewBinding" } },
    "signatureMoment": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/signature" }] },
    "hostApproval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAt", "operationId"],
      "properties": { "status": { "enum": ["required", "approved", "rejected"] }, "approvedBy": { "type": ["string", "null"] }, "approvedAt": { "type": ["string", "null"] }, "operationId": { "type": ["string", "null"] } }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "budget": { "type": "object", "additionalProperties": false, "required": ["used", "max"], "properties": { "used": { "type": "integer", "minimum": 0, "maximum": 3 }, "max": { "const": 3 } } },
    "bestIdentity": { "type": "object", "additionalProperties": false, "required": ["semanticIrHash", "manifestHash", "pptxHash", "vector"], "properties": { "semanticIrHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" }, "pptxHash": { "$ref": "#/$defs/hash" }, "vector": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "type": "number" } } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["source", "path"], "properties": { "source": { "$ref": "#/$defs/nonEmpty" }, "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" } } },
    "scope": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "deck" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "slideId"], "properties": { "kind": { "const": "slide" }, "slideId": { "$ref": "#/$defs/nonEmpty" }, "nodeId": { "$ref": "#/$defs/nonEmpty" }, "elementId": { "$ref": "#/$defs/nonEmpty" } } }] },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["source", "author", "hostAuthored"], "properties": { "source": { "enum": ["router", "host"] }, "author": { "$ref": "#/$defs/nonEmpty" }, "hostAuthored": { "type": "boolean" } } },
    "approval": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "enum": ["required", "approved", "rejected"] }, "approvedBy": { "$ref": "#/$defs/nonEmpty" }, "evidence": { "$ref": "#/$defs/nonEmpty" } } },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "scope", "evidence", "reason", "risk", "expectedDelta", "targetLayer", "delta", "rollback", "provenance", "approval"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "command": { "enum": ["typeset", "layout", "colorize", "bolder", "quieter", "distill", "harden", "polish", "overdrive"] },
        "scope": { "$ref": "#/$defs/scope" }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "reason": { "$ref": "#/$defs/nonEmpty" }, "risk": { "enum": ["optical", "semantic"] }, "expectedDelta": { "$ref": "#/$defs/nonEmpty" },
        "targetLayer": { "enum": ["ir", "manifest"] }, "delta": { "$ref": "#/$defs/delta" }, "rollback": { "$ref": "#/$defs/delta" },
        "provenance": { "$ref": "#/$defs/provenance" }, "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "change": { "type": "object", "additionalProperties": false, "required": ["before", "after", "tolerance"], "properties": { "before": {}, "after": {}, "tolerance": { "type": "number", "minimum": 0 } } },
    "opticalDelta": { "type": "object", "additionalProperties": false, "required": ["kind", "slideId", "elementId", "changes"], "properties": { "kind": { "const": "optical" }, "slideId": { "$ref": "#/$defs/nonEmpty" }, "elementId": { "$ref": "#/$defs/nonEmpty" }, "changes": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "x": { "$ref": "#/$defs/change" }, "y": { "$ref": "#/$defs/change" }, "w": { "$ref": "#/$defs/change" }, "h": { "$ref": "#/$defs/change" }, "fontSize": { "$ref": "#/$defs/change" }, "lineHeight": { "$ref": "#/$defs/change" }, "transparency": { "$ref": "#/$defs/change" }, "contrast": { "$ref": "#/$defs/change" }, "crop": { "$ref": "#/$defs/change" } } } } },
    "semanticDelta": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "before", "after"], "properties": { "kind": { "const": "semantic" }, "path": { "type": "array", "minItems": 2, "items": { "type": "string", "not": { "enum": ["x", "y", "w", "h", "elements"] } }, "before": {}, "after": {} } } },
    "delta": { "oneOf": [{ "$ref": "#/$defs/opticalDelta" }, { "$ref": "#/$defs/semanticDelta" }] },
    "signature": { "type": "object", "additionalProperties": false, "required": ["operationId", "slideId", "nodeId", "kind", "evidence"], "properties": { "operationId": { "$ref": "#/$defs/nonEmpty" }, "slideId": { "$ref": "#/$defs/nonEmpty" }, "nodeId": { "$ref": "#/$defs/nonEmpty" }, "kind": { "const": "signature" }, "evidence": { "$ref": "#/$defs/nonEmpty" } } },
    "reviewBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["proofHash", "packetHash", "reviewHash"],
      "properties": { "proofHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }, "packetHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }, "reviewHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" } }
    }
  }
}
