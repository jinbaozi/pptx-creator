{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/visual-review.schema.json",
  "title": "Visual Review",
  "type": "object",
  "required": ["deckScore", "slides"],
  "properties": {
    "deckScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "slopRisk": { "type": "number", "minimum": 0, "maximum": 100 },
    "mode": { "type": "string", "enum": ["creative", "replica"] },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score", "scores", "issues", "recommendedRepairs"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "scores": { "type": "object" },
          "issues": { "type": "array" },
          "recommendedRepairs": { "type": "array" },
          "slopSignals": { "type": "array", "items": { "$ref": "#/$defs/slopSignal" } }
        }
      }
    }
  },
  "$defs": {
    "slopSignal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "weight", "count", "category", "severity", "confidence", "evidence", "repairCommand", "applicable", "exempted", "exemption", "brandOverrideAllowed", "readabilityOverrideAllowed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "weight": { "type": "number", "minimum": 0 }, "count": { "type": "number", "minimum": 0 },
        "category": { "type": "string", "minLength": 1 }, "severity": { "enum": ["P0", "P1", "P2"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "repairCommand": { "enum": ["typeset", "layout", "colorize", "bolder", "quieter", "distill", "harden", "polish", "overdrive"] },
        "applicable": { "type": "boolean" }, "exempted": { "type": "boolean" }, "exemption": { "type": ["string", "null"] },
        "brandOverrideAllowed": { "type": "boolean" }, "readabilityOverrideAllowed": { "const": false }
      }
    }
  }
}
