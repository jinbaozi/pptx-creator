{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pptx-creator.local/pptx-geometry-report.schema.json",
  "title": "PPTX Geometry and Object Lineage Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pptx", "slides", "findings", "summary"],
  "properties": {
    "version": { "const": "0.4.0" },
    "pptx": { "type": "string", "minLength": 1 },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "expectedObjectCount", "matchedObjectCount", "objectCount"],
        "properties": {
          "slideId": { "type": "string", "minLength": 1 },
          "expectedObjectCount": { "type": "integer", "minimum": 0 },
          "matchedObjectCount": { "type": "integer", "minimum": 0 },
          "objectCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "elementId", "kind", "severity", "message"],
        "properties": {
          "slideId": { "type": "string", "minLength": 1 },
          "elementId": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "negative-line-extent",
              "pptx-object-lineage",
              "content-occlusion",
              "decoration-occlusion",
              "connector-detached",
              "connector-marker-missing",
              "connector-direction",
              "connector-obstructed",
              "connector-route-invalid"
            ]
          },
          "severity": { "enum": ["critical", "warning"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideCount", "criticalCount", "warningCount", "blocked"],
      "properties": {
        "slideCount": { "type": "integer", "minimum": 0 },
        "criticalCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "boolean" }
      }
    }
  }
}
