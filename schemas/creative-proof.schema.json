{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/creative-proof.schema.json",
  "title": "Creative Rendered Visual Proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "accepted", "expectedSlides", "renderedSlides", "decorativeBackgroundLines", "previews", "contactSheet", "textFit", "quality", "repair", "p0", "p1", "p2"],
  "properties": {
    "version": { "const": "0.1.0" },
    "mode": { "const": "creative" },
    "accepted": { "type": "boolean" },
    "expectedSlides": { "type": "integer", "minimum": 0 },
    "renderedSlides": { "type": "integer", "minimum": 0 },
    "decorativeBackgroundLines": { "type": "integer", "minimum": 0 },
    "previews": { "type": "array", "items": { "type": "string" } },
    "contactSheet": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "slideCount", "width", "height"],
          "properties": {
            "path": { "type": "string" }, "slideCount": { "type": "integer", "minimum": 1 },
            "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "textFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "summary"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "unavailable"] },
        "source": { "type": "string", "enum": ["fontkit", "heuristic", "unavailable"] },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "overflowCount"],
          "properties": {
            "checked": { "type": "integer", "minimum": 0 },
            "overflowCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deckScore", "slideFloor", "slopRisk", "criticalFindings", "editabilityLevel", "gate"],
      "properties": {
        "deckScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "slideFloor": { "type": "number", "minimum": 0, "maximum": 100 },
        "slopRisk": { "type": "number", "minimum": 0, "maximum": 100 },
        "criticalFindings": { "type": "integer", "minimum": 0 },
        "editabilityLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "reasons"],
          "properties": {
            "passed": { "type": "boolean" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "stopReason", "history"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "stopReason": {
          "type": "string",
          "enum": ["not-run", "initial-proof-passed", "accepted", "repair-unavailable", "no-improvement", "attempt-limit", "publication-failed"]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["iteration", "outcome"],
            "properties": {
              "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
              "outcome": { "type": "string", "enum": ["unavailable", "accepted", "no-improvement", "improved"] },
              "comparison": { "type": "number" },
              "score": { "type": "number" }
            }
          }
        }
      }
    },
    "p0": { "$ref": "#/$defs/findings" },
    "p1": { "$ref": "#/$defs/findings" },
    "p2": { "$ref": "#/$defs/findings" }
  },
  "$defs": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "message"],
        "properties": { "type": { "type": "string" }, "message": { "type": "string" }, "slideId": { "type": "string" } }
      }
    }
  }
}
