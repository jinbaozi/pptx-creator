{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/creative-proof.schema.json",
  "title": "Creative Visual Proof 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identity", "rendering", "hardGates", "tokenLedger", "assetLedger", "diagnostics", "hostVisualReview", "selection", "suites", "repair", "refinement", "findings", "acceptance", "accepted"],
  "properties": {
    "version": { "const": "0.2.0" },
    "identity": { "$ref": "#/$defs/identity" },
    "rendering": { "$ref": "#/$defs/rendering" },
    "hardGates": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/gate" } },
    "tokenLedger": { "$ref": "#/$defs/tokenLedger" },
    "assetLedger": { "$ref": "#/$defs/assetLedger" },
    "diagnostics": { "$ref": "#/$defs/diagnostics" },
    "hostVisualReview": { "$ref": "#/$defs/hostReviewSummary" },
    "selection": { "$ref": "#/$defs/selection" },
    "suites": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/suite" } },
    "repair": { "$ref": "#/$defs/repair" },
    "refinement": { "$ref": "#/$defs/refinement" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "accepted": { "type": "boolean" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "hash"],
      "properties": { "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "nullableArtifact": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "semanticIr", "manifest", "pptx", "designTokens", "assetRegistry", "selection", "refinement"],
      "properties": {
        "purpose": { "enum": ["final-deck", "direction-probe"] },
        "semanticIr": { "$ref": "#/$defs/artifact" }, "manifest": { "$ref": "#/$defs/artifact" },
        "pptx": { "$ref": "#/$defs/artifact" }, "designTokens": { "$ref": "#/$defs/artifact" },
        "assetRegistry": { "$ref": "#/$defs/artifact" }, "selection": { "$ref": "#/$defs/nullableArtifact" },
        "refinement": { "$ref": "#/$defs/nullableArtifact" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["renderer", "suite", "platform", "architecture", "libreOfficeVersion", "pythonVersion", "commandIdentity", "settings"],
      "properties": {
        "renderer": { "const": "libreoffice" }, "suite": { "const": "libreoffice" },
        "platform": { "$ref": "#/$defs/nonEmpty" }, "architecture": { "$ref": "#/$defs/nonEmpty" },
        "libreOfficeVersion": { "$ref": "#/$defs/nonEmpty" }, "pythonVersion": { "$ref": "#/$defs/nonEmpty" },
        "commandIdentity": { "$ref": "#/$defs/nonEmpty" },
        "settings": {
          "type": "object", "additionalProperties": false, "required": ["dpi", "colorMode", "timestampFree"],
          "properties": {
            "dpi": { "type": "integer", "minimum": 1 },
            "colorMode": { "const": "RGB" },
            "timestampFree": { "const": true },
            "fontConfigOverride": { "type": "boolean" },
            "fontDirectoryCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["slideId", "index", "path", "hash", "width", "height"],
      "properties": {
        "slideId": { "$ref": "#/$defs/nonEmpty" }, "index": { "type": "integer", "minimum": 0 },
        "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      }
    },
    "contactSheet": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "hash", "width", "height", "slideIds", "slideHashes"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 },
        "slideIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "slideHashes": { "type": "array", "items": { "$ref": "#/$defs/hash" } }
      }
    },
    "rendering": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "environment", "expectedPageCount", "renderedPageCount", "pages", "contactSheet", "renderReport"],
      "properties": {
        "status": { "enum": ["passed", "failed", "unavailable"] }, "environment": { "$ref": "#/$defs/environment" },
        "expectedPageCount": { "type": "integer", "minimum": 0 }, "renderedPageCount": { "type": "integer", "minimum": 0 },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } }, "contactSheet": { "$ref": "#/$defs/contactSheet" },
        "renderReport": { "$ref": "#/$defs/artifact" }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "required", "evidence", "reasons"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "status": { "enum": ["passed", "failed", "unavailable", "not-applicable"] },
        "required": { "type": "boolean" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "drift": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "expected", "actual"],
      "properties": { "assetId": { "$ref": "#/$defs/nonEmpty" }, "field": { "$ref": "#/$defs/nonEmpty" }, "expected": {}, "actual": {} }
    },
    "tokenLedger": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "status", "expectedSnapshotHash", "actualSnapshotHash", "designSystem", "protectedTokens", "drift", "lineage"],
      "properties": {
        "version": { "const": "0.1.0" }, "status": { "enum": ["passed", "failed", "unavailable"] },
        "expectedSnapshotHash": { "$ref": "#/$defs/nullableHash" }, "actualSnapshotHash": { "$ref": "#/$defs/nullableHash" },
        "designSystem": { "type": "object", "additionalProperties": false, "required": ["name", "source"], "properties": { "name": { "type": ["string", "null"] }, "source": { "type": ["string", "null"] } } },
        "protectedTokens": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "status"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmpty" },
              "status": { "enum": ["snapshot-bound", "drifted", "unavailable"] }
            }
          }
        },
        "drift": { "type": "array", "items": { "$ref": "#/$defs/drift" } }, "lineage": { "const": "snapshot-only" }
      }
    },
    "assetLedger": {
      "type": "object", "additionalProperties": false, "required": ["version", "status", "assets", "drift"],
      "properties": {
        "version": { "const": "0.1.0" }, "status": { "enum": ["passed", "failed", "unavailable"] },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/ledgerAsset" } }, "drift": { "type": "array", "items": { "$ref": "#/$defs/drift" } }
      }
    },
    "assetSource": {
      "type": "object", "additionalProperties": false, "required": ["origin", "sourceRef"],
      "properties": { "origin": { "enum": ["user", "project", "web", "generated"] }, "sourceRef": { "$ref": "#/$defs/nonEmpty" }, "sourceUrl": { "$ref": "#/$defs/nonEmpty" } }
    },
    "assetRights": {
      "type": "object", "additionalProperties": false, "required": ["status", "license"],
      "properties": { "status": { "enum": ["allowed", "allowed-with-attribution", "user-provided", "public-domain", "unknown"] }, "license": { "$ref": "#/$defs/nonEmpty" }, "attribution": { "$ref": "#/$defs/nonEmpty" } }
    },
    "assetGeneration": {
      "type": "object", "additionalProperties": false, "required": ["model", "promptSummary"],
      "properties": { "model": { "$ref": "#/$defs/nonEmpty" }, "promptSummary": { "$ref": "#/$defs/nonEmpty" } }
    },
    "assetFallback": {
      "type": "object", "additionalProperties": false, "required": ["strategy", "description"],
      "properties": { "strategy": { "enum": ["omit", "placeholder", "native-diagram", "text"] }, "description": { "$ref": "#/$defs/nonEmpty" } }
    },
    "ledgerAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "source", "rights", "localPath", "expectedHash", "actualHash", "irUsage", "manifestUsage", "altText", "focalPoint", "cropPolicy", "fallback", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "role": { "$ref": "#/$defs/nonEmpty" }, "source": { "$ref": "#/$defs/assetSource" }, "rights": { "$ref": "#/$defs/assetRights" }, "generation": { "$ref": "#/$defs/assetGeneration" },
        "localPath": { "$ref": "#/$defs/nonEmpty" }, "expectedHash": { "$ref": "#/$defs/nullableHash" }, "actualHash": { "$ref": "#/$defs/nullableHash" },
        "irUsage": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }, "manifestUsage": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "altText": { "$ref": "#/$defs/nonEmpty" }, "focalPoint": { "$ref": "#/$defs/nonEmpty" }, "cropPolicy": { "$ref": "#/$defs/nonEmpty" }, "fallback": { "$ref": "#/$defs/assetFallback" }, "status": { "enum": ["passed", "failed"] }
      }
    },
    "diagnosticStatus": { "enum": ["passed", "failed", "unavailable", "not-applicable"] },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["thumbnailReadability", "antiSlop", "nativeCoverage", "rhythm", "quality", "visualCritic"],
      "properties": {
        "thumbnailReadability": { "type": "object", "additionalProperties": false, "required": ["status", "checkedSlides", "failures"], "properties": { "status": { "$ref": "#/$defs/diagnosticStatus" }, "checkedSlides": { "type": "integer", "minimum": 0 }, "failures": { "type": "array" } } },
        "antiSlop": { "type": "object", "additionalProperties": false, "required": ["status", "risk", "findings"], "properties": { "status": { "$ref": "#/$defs/diagnosticStatus" }, "risk": { "type": "number", "minimum": 0, "maximum": 100 }, "findings": { "type": "array" } } },
        "nativeCoverage": { "type": "object", "additionalProperties": false, "required": ["status", "editabilityLevel", "nativeObjects", "rasterObjects"], "properties": { "status": { "$ref": "#/$defs/diagnosticStatus" }, "editabilityLevel": { "type": "integer", "minimum": 1, "maximum": 5 }, "nativeObjects": { "type": "integer", "minimum": 0 }, "rasterObjects": { "type": "integer", "minimum": 0 } } },
        "rhythm": { "type": "object", "additionalProperties": false, "required": ["status", "topologyRuns", "densityRuns"], "properties": { "status": { "$ref": "#/$defs/diagnosticStatus" }, "topologyRuns": { "type": "array" }, "densityRuns": { "type": "array" } } },
        "quality": { "type": "object", "additionalProperties": false, "required": ["status", "deckScore", "slideFloor"], "properties": { "status": { "$ref": "#/$defs/diagnosticStatus" }, "deckScore": { "type": "number" }, "slideFloor": { "type": "number" } } },
        "visualCritic": { "type": "object", "additionalProperties": false, "required": ["status", "findings"], "properties": { "status": { "$ref": "#/$defs/diagnosticStatus" }, "findings": { "type": "array" } } }
      }
    },
    "hostReviewSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "packetHash", "reviewHash", "overallVerdict", "perSlideCount", "signatureMoment", "summary", "findings"],
      "properties": {
        "status": { "enum": ["missing", "unavailable", "invalid", "completed"] }, "packetHash": { "$ref": "#/$defs/hash" },
        "reviewHash": { "$ref": "#/$defs/nullableHash" }, "overallVerdict": { "type": ["string", "null"], "enum": ["accept", "reject", "unavailable", null] },
        "perSlideCount": { "type": "integer", "minimum": 0 }, "signatureMoment": { "type": ["string", "null"], "enum": ["restrained", "overused", "absent-appropriate", "missing", null] }, "summary": { "type": ["string", "null"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["not-applicable", "valid", "invalid"] }, "reason": { "$ref": "#/$defs/nonEmpty" },
        "candidateSetHash": { "$ref": "#/$defs/hash" }, "selectionHash": { "$ref": "#/$defs/hash" }, "selectedCandidateId": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false, "required": ["suite", "required", "status", "environment", "artifacts", "reason"],
      "properties": {
        "suite": { "enum": ["libreoffice", "powerpoint", "wps"] }, "required": { "type": "boolean" },
        "status": { "enum": ["passed", "failed", "unavailable", "not-applicable"] }, "environment": { "type": ["string", "null"] },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }, "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false, "required": ["attempts", "stopReason", "history"],
      "properties": { "attempts": { "type": "integer", "minimum": 0, "maximum": 3 }, "stopReason": { "$ref": "#/$defs/nonEmpty" }, "history": { "type": "array", "items": { "type": "object" } } }
    },
    "refinement": {
      "type": "object", "additionalProperties": false, "required": ["status", "plan", "history", "finalIdentity"],
      "properties": {
        "status": { "enum": ["not-applicable", "planned", "applied", "failed"] }, "plan": { "type": ["object", "null"] }, "history": { "type": "array", "items": { "type": "object" } },
        "finalIdentity": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["semanticIrHash", "manifestHash", "pptxHash"], "properties": { "semanticIrHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" }, "pptxHash": { "$ref": "#/$defs/hash" } } }
          ]
        }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false, "required": ["severity", "source", "type", "message", "evidence"],
      "properties": {
        "severity": { "enum": ["P0", "P1", "P2"] }, "source": { "$ref": "#/$defs/nonEmpty" },
        "type": { "$ref": "#/$defs/nonEmpty" }, "message": { "$ref": "#/$defs/nonEmpty" },
        "slideId": { "$ref": "#/$defs/nonEmpty" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["status", "reasons"],
      "properties": { "status": { "enum": ["accepted", "blocked", "awaiting-host-review", "evidence-ready"] }, "reasons": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } } }
    }
  }
}
