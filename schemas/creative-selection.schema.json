{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/creative-selection.schema.json",
  "title": "Creative Blind Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "explorationId", "packetHash", "candidateSetHash", "selectedBlindId", "selectedCandidateId", "reveal", "pairwise", "hostReview", "diagnosticEvidence", "acceptance"],
  "properties": {
    "version": { "const": "0.1.0" },
    "explorationId": { "$ref": "#/$defs/explorationId" },
    "packetHash": { "$ref": "#/$defs/hash" },
    "candidateSetHash": { "$ref": "#/$defs/hash" },
    "selectedBlindId": { "$ref": "#/$defs/blindId" },
    "selectedCandidateId": { "$ref": "#/$defs/nonEmpty" },
    "reveal": { "type": "object", "minProperties": 2, "maxProperties": 4, "propertyNames": { "$ref": "#/$defs/blindId" }, "additionalProperties": { "$ref": "#/$defs/nonEmpty" } },
    "pairwise": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair" } },
    "hostReview": { "$ref": "#/$defs/hostReview" },
    "diagnosticEvidence": { "type": "object", "minProperties": 2, "maxProperties": 4, "propertyNames": { "$ref": "#/$defs/blindId" }, "additionalProperties": { "$ref": "#/$defs/diagnostic" } },
    "acceptance": {
      "type": "object", "additionalProperties": false, "required": ["status", "primaryBasis"],
      "properties": { "status": { "const": "selected" }, "primaryBasis": { "const": "host-blind-pairwise" } }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "explorationId": { "type": "string", "pattern": "^explore-[a-f0-9]{24}$" },
    "blindId": { "type": "string", "pattern": "^blind-[0-9]{2}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right", "leftScreenshotHash", "rightScreenshotHash", "preference", "reason"],
      "properties": {
        "left": { "$ref": "#/$defs/blindId" }, "right": { "$ref": "#/$defs/blindId" },
        "leftScreenshotHash": { "$ref": "#/$defs/hash" }, "rightScreenshotHash": { "$ref": "#/$defs/hash" },
        "preference": { "enum": ["left", "right", "tie"] }, "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "adjudication": {
      "type": "object", "additionalProperties": false, "required": ["blindId", "reason"],
      "properties": { "blindId": { "$ref": "#/$defs/blindId" }, "reason": { "$ref": "#/$defs/nonEmpty" } }
    },
    "hostReview": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "explorationId", "packetHash", "available", "pairs"],
      "properties": {
        "version": { "const": "0.1.0" }, "explorationId": { "$ref": "#/$defs/explorationId" },
        "packetHash": { "$ref": "#/$defs/hash" }, "available": { "const": true },
        "pairs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair" } },
        "adjudication": { "$ref": "#/$defs/adjudication" }
      }
    },
    "diagnosticDimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["narrative", "hierarchy", "composition-whitespace", "typography", "color-material", "deck-rhythm", "consistency", "asset-specificity", "data-diagram-readability", "brand-distinctiveness"],
      "properties": {
        "narrative": { "type": "number" }, "hierarchy": { "type": "number" }, "composition-whitespace": { "type": "number" },
        "typography": { "type": "number" }, "color-material": { "type": "number" }, "deck-rhythm": { "type": "number" },
        "consistency": { "type": "number" }, "asset-specificity": { "type": "number" },
        "data-diagram-readability": { "type": "number" }, "brand-distinctiveness": { "type": "number" }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["weights", "dimensions", "weightedScore", "slopRisk"],
      "properties": {
        "weights": { "$ref": "#/$defs/diagnosticDimensions" }, "dimensions": { "$ref": "#/$defs/diagnosticDimensions" },
        "weightedScore": { "type": "number", "minimum": 0, "maximum": 100 }, "slopRisk": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
