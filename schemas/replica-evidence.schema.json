{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/schemas/replica-evidence.schema.json",
  "title": "Replica Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "route", "paths", "capabilities", "thresholds", "source", "render", "perSlide", "aggregate", "retry", "accepted", "blockingFindings"],
  "properties": {
    "version": { "const": "0.1.0" },
    "mode": { "const": "replica" },
    "route": { "enum": ["html", "html-editable", "image"] },
    "applicable": { "type": "boolean" },
    "paths": {
      "type": "object", "additionalProperties": false, "required": ["source", "render"],
      "properties": { "source": { "$ref": "#/$defs/artifactPath" }, "render": { "$ref": "#/$defs/artifactPath" } }
    },
    "capabilities": {
      "type": "object", "additionalProperties": { "type": "boolean" },
      "required": ["sourceRenderComparison", "nativeObjectInspection", "fallbackInventory"],
      "properties": { "sourceRenderComparison": { "type": "boolean" }, "nativeObjectInspection": { "type": "boolean" }, "fallbackInventory": { "type": "boolean" } }
    },
    "thresholds": { "$ref": "#/$defs/policy" },
    "source": { "$ref": "#/$defs/artifact" },
    "render": { "$ref": "#/$defs/artifact" },
    "perSlide": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slideEvidence" } },
    "aggregate": { "$ref": "#/$defs/aggregateEvidence" },
    "retry": { "$ref": "#/$defs/retry" },
    "accepted": { "type": "boolean" },
    "blockingFindings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    { "if": { "properties": { "route": { "enum": ["html", "html-editable"] } } }, "then": { "properties": {
      "thresholds": { "$ref": "#/$defs/htmlPolicy" },
      "aggregate": { "properties": { "fidelity": { "$ref": "#/$defs/htmlFidelity" } } },
      "perSlide": { "items": { "properties": { "fidelity": { "$ref": "#/$defs/htmlFidelity" } } } }
    } } },
    { "if": { "properties": { "route": { "const": "image" } } }, "then": { "properties": {
      "thresholds": { "$ref": "#/$defs/imagePolicy" },
      "aggregate": { "properties": { "fidelity": { "$ref": "#/$defs/imageFidelity" } } },
      "perSlide": { "items": { "properties": { "fidelity": { "$ref": "#/$defs/imageFidelity" } } } }
    } } }
  ],
  "$defs": {
    "artifactPath": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["status", "path", "sha256", "bytes"], "properties": { "status": { "const": "available" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 } } },
      { "type": "object", "additionalProperties": false, "required": ["status", "path", "sha256", "bytes", "reason"], "properties": { "status": { "const": "unavailable" }, "path": { "type": "null" }, "sha256": { "type": "null" }, "bytes": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } } }
    ] },
    "retry": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["status", "attempts"], "properties": { "status": { "const": "available" }, "attempts": { "type": "array", "maxItems": 3, "items": { "type": "object" } } } },
      { "type": "object", "additionalProperties": false, "required": ["status", "attempts", "reason"], "properties": { "status": { "const": "unavailable" }, "attempts": { "type": "array", "maxItems": 0 }, "reason": { "type": "string", "minLength": 1 } } }
    ] },
    "size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["pageCount", "size"],
      "properties": { "pageCount": { "type": "integer", "minimum": 1 }, "size": { "$ref": "#/$defs/size" } }
    },
    "metric": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": { "status": { "const": "available" }, "value": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value", "reason"], "properties": { "status": { "const": "unavailable" }, "value": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } } }
      ]
    },
    "fidelity": {
      "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" }, "minProperties": 1
    },
    "htmlFidelity": { "type": "object", "additionalProperties": false, "required": ["ssim", "normalizedMae", "bboxP95Drift", "bboxMaxDrift", "fontMapping", "colorMapping", "nativeObjectRecall", "nativeTextRecall"], "properties": { "ssim": { "$ref": "#/$defs/metric" }, "normalizedMae": { "$ref": "#/$defs/metric" }, "bboxP95Drift": { "$ref": "#/$defs/metric" }, "bboxMaxDrift": { "$ref": "#/$defs/metric" }, "fontMapping": { "$ref": "#/$defs/metric" }, "colorMapping": { "$ref": "#/$defs/metric" }, "nativeObjectRecall": { "$ref": "#/$defs/metric" }, "nativeTextRecall": { "$ref": "#/$defs/metric" } } },
    "imageFidelity": { "type": "object", "additionalProperties": false, "required": ["ssim", "ocrCer", "bboxIou", "paletteDeltaE2000P95", "nativeHighConfidenceTextRecall"], "properties": { "ssim": { "$ref": "#/$defs/metric" }, "ocrCer": { "$ref": "#/$defs/metric" }, "bboxIou": { "$ref": "#/$defs/metric" }, "paletteDeltaE2000P95": { "$ref": "#/$defs/metric" }, "nativeHighConfidenceTextRecall": { "$ref": "#/$defs/metric" } } },
    "htmlPolicy": { "type": "object", "additionalProperties": false, "required": ["fidelity", "nativeCoverage", "editability"], "properties": {
      "fidelity": { "type": "object", "additionalProperties": false, "required": ["ssim", "normalizedMae", "bboxP95Drift", "bboxMaxDrift", "fontMapping", "colorMapping", "nativeObjectRecall", "nativeTextRecall"], "properties": { "ssim": { "type": "object", "properties": { "min": { "type": "number", "minimum": 0.85, "maximum": 1 } }, "required": ["min"], "additionalProperties": false }, "normalizedMae": { "type": "object", "properties": { "max": { "type": "number", "minimum": 0, "maximum": 0.047058823529411764 } }, "required": ["max"], "additionalProperties": false }, "bboxP95Drift": { "type": "object", "properties": { "max": { "type": "number", "minimum": 0, "maximum": 4 } }, "required": ["max"], "additionalProperties": false }, "bboxMaxDrift": { "type": "object", "properties": { "max": { "type": "number", "minimum": 0, "maximum": 4 } }, "required": ["max"], "additionalProperties": false }, "fontMapping": { "type": "object", "properties": { "min": { "type": "number", "minimum": 0.95, "maximum": 1 } }, "required": ["min"], "additionalProperties": false }, "colorMapping": { "type": "object", "properties": { "min": { "type": "number", "minimum": 0.75, "maximum": 1 } }, "required": ["min"], "additionalProperties": false }, "nativeObjectRecall": { "type": "object", "properties": { "min": { "type": "number", "minimum": 0.95, "maximum": 1 } }, "required": ["min"], "additionalProperties": false }, "nativeTextRecall": { "type": "object", "properties": { "min": { "type": "number", "minimum": 0.95, "maximum": 1 } }, "required": ["min"], "additionalProperties": false } } },
      "nativeCoverage": { "type": "object", "properties": { "min": { "const": 0.95 } }, "required": ["min"], "additionalProperties": false }, "editability": { "type": "object", "properties": { "min": { "const": 4 } }, "required": ["min"], "additionalProperties": false }
    } },
    "imagePolicy": { "type": "object", "additionalProperties": false, "required": ["fidelity", "nativeCoverage", "editability"], "properties": {
      "fidelity": { "type": "object", "additionalProperties": false, "required": ["ssim", "ocrCer", "bboxIou", "paletteDeltaE2000P95", "nativeHighConfidenceTextRecall"], "properties": { "ssim": { "type": "object", "properties": { "min": { "const": 0.94 } }, "required": ["min"], "additionalProperties": false }, "ocrCer": { "type": "object", "properties": { "max": { "const": 0.02 } }, "required": ["max"], "additionalProperties": false }, "bboxIou": { "type": "object", "properties": { "min": { "const": 0.9 } }, "required": ["min"], "additionalProperties": false }, "paletteDeltaE2000P95": { "type": "object", "properties": { "max": { "const": 3 } }, "required": ["max"], "additionalProperties": false }, "nativeHighConfidenceTextRecall": { "type": "object", "properties": { "min": { "const": 0.9 } }, "required": ["min"], "additionalProperties": false } } },
      "nativeCoverage": { "type": "object", "properties": { "min": { "const": 0 } }, "required": ["min"], "additionalProperties": false }, "editability": { "type": "object", "properties": { "min": { "const": 3 } }, "required": ["min"], "additionalProperties": false }
    } },
    "editability": {
      "type": "object", "additionalProperties": false, "required": ["level"],
      "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 5 } }
    },
    "bbox": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "fallback": {
      "type": "object", "additionalProperties": false, "required": ["kind", "fullSlide", "reason", "bbox", "zOrder", "nativeAlternativesAttempted"],
      "properties": {
        "kind": { "const": "raster" }, "fullSlide": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 },
        "bbox": { "$ref": "#/$defs/bbox" }, "zOrder": { "type": "integer" },
        "nativeAlternativesAttempted": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "slideEvidence": {
      "type": "object", "additionalProperties": false, "required": ["slideIndex", "fidelity", "nativeCoverage", "editability", "fallbacks"],
      "properties": {
        "slideIndex": { "type": "integer", "minimum": 0 }, "fidelity": { "$ref": "#/$defs/fidelity" },
        "nativeCoverage": { "$ref": "#/$defs/metric" }, "editability": { "$ref": "#/$defs/editability" },
        "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/fallback" } }
      }
    },
    "aggregateEvidence": {
      "type": "object", "additionalProperties": false, "required": ["fidelity", "nativeCoverage", "editability", "fallbacks"],
      "properties": {
        "fidelity": { "$ref": "#/$defs/fidelity" }, "nativeCoverage": { "$ref": "#/$defs/metric" },
        "editability": { "$ref": "#/$defs/editability" }, "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/fallback" } }
      }
    },
    "bound": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["fidelity", "nativeCoverage", "editability"],
      "properties": {
        "fidelity": { "type": "object", "additionalProperties": { "$ref": "#/$defs/bound" } },
        "nativeCoverage": { "$ref": "#/$defs/bound" }, "editability": { "$ref": "#/$defs/bound" }
      }
    }
  }
}
