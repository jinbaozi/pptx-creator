{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/creative-direction-request.schema.json",
  "title": "Host Creative Direction Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "planHash", "directions"],
  "properties": {
    "version": { "const": "0.1.0" },
    "planHash": { "$ref": "#/$defs/hash" },
    "directions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/direction" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "axis": {
      "enum": ["layout-topology", "hierarchy", "typography", "density", "color-material", "asset-strategy", "diagram-strategy", "deck-rhythm"]
    },
    "dial": { "type": "number", "minimum": 0, "maximum": 100 },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "rationale", "declaredAxes", "projection"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "declaredAxes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axis" }
        },
        "projection": { "$ref": "#/$defs/projection" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designSystem"],
      "properties": {
        "designSystem": { "$ref": "#/$defs/nonEmpty" },
        "route": { "const": "native" },
        "dials": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "compositionVariance": { "$ref": "#/$defs/dial" },
            "visualDensity": { "$ref": "#/$defs/dial" },
            "visualEnergy": { "$ref": "#/$defs/dial" }
          }
        },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slideId", "blockId"],
            "properties": {
              "slideId": { "type": "string", "pattern": "^slide-" },
              "blockId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        }
      }
    }
  }
}
