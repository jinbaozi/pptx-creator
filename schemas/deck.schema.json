{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/deck.schema.json",
  "title": "Deck Manifest",
  "type": "object",
  "required": ["version", "metadata", "designSystem", "deck", "assets", "slides"],
  "propertyNames": { "not": { "pattern": "^_" } },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "semanticPageRole": {
      "enum": ["cover", "section", "single-point", "evidence", "data", "comparison", "process", "architecture", "case-study", "quote", "decision", "closing", "appendix"]
    },
    "attentionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["message", "content", "asset", "data", "diagram"] },
        "ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "compositionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "whitespace", "emphasis"],
      "properties": {
        "strategy": { "enum": ["asymmetric", "split", "focus", "editorial", "immersive", "data-led", "structural", "minimal-whitespace"] },
        "whitespace": { "enum": ["compact", "balanced", "spacious"] },
        "emphasis": { "enum": ["message", "evidence", "asset", "data"] },
        "blockId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1, "maxLength": 80 }
      }
    },
    "routePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "allowed", "fullSlideRaster"],
      "properties": {
        "preferred": { "const": "native" },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "native" },
          "items": { "enum": ["native", "html-assisted", "local-raster"] }
        },
        "fullSlideRaster": { "const": false }
      }
    },
    "focalPoint": { "enum": ["center", "top", "right", "bottom", "left", "top-left", "top-right", "bottom-left", "bottom-right"] },
    "cropPolicy": { "enum": ["contain", "cover", "smart-crop", "none"] },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["cover", "contain", "crop"] },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "sourceW": { "type": "number", "exclusiveMinimum": 0 },
        "sourceH": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "crop" } } },
          "then": { "required": ["x", "y", "w", "h"] }
        }
      ]
    }
  },
  "properties": {
    "version": { "type": "string", "const": "0.2.0" },
    "metadata": {
      "type": "object",
      "required": ["mode", "inputType", "qualityProfile"],
      "properties": {
        "mode": { "type": "string", "enum": ["direct", "creative", "replica", "repair"] },
        "inputType": { "type": "string", "enum": ["text", "html", "image", "pdf", "manifest", "mixed"] },
        "qualityProfile": { "type": "string", "enum": ["light", "creative", "replica"] },
        "designIntent": {
          "type": "object",
          "properties": {
            "visibleGrid": { "type": "boolean", "default": false }
          }
        },
        "replicaSource": { "type": "object" },
        "generator": { "type": "object" }
      },
      "additionalProperties": false
    },
    "designSystem": {
      "type": "object",
      "required": ["source", "name"],
      "properties": {
        "source": { "type": "string" },
        "name": { "type": "string" },
        "tokens": { "type": "object" }
      },
      "additionalProperties": false
    },
    "deck": {
      "type": "object",
      "required": ["title", "language", "size"],
      "properties": {
        "title": { "type": "string" },
        "language": { "type": "string" },
        "size": {
          "type": "object",
          "required": ["preset", "width", "height", "unit"],
          "properties": {
            "preset": { "type": "string" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "const": "in" }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "src"],
        "properties": {
          "id": { "type": "string" },
          "src": { "type": "string" }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "background", "elements"],
        "properties": {
          "id": { "type": "string", "pattern": "^slide-" },
          "type": { "type": "string" },
          "pageRole": { "type": "string", "enum": ["cover", "section", "point", "evidence", "comparison", "process", "architecture", "data", "case-study", "quote", "closing"] },
          "semanticPageRole": { "$ref": "#/$defs/semanticPageRole" },
          "compositionStrategy": { "type": ["string", "null"], "enum": ["asymmetric", "split", "focus", "editorial", "immersive", "data-led", "structural", "minimal-whitespace", null] },
          "attentionTarget": { "$ref": "#/$defs/attentionTarget" },
          "compositionIntent": { "$ref": "#/$defs/compositionIntent" },
          "routePolicy": { "$ref": "#/$defs/routePolicy" },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "background": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["solid", "image", "gradient"] },
              "color": { "type": "string" },
              "src": { "type": "string" },
              "gradient": { "type": "object" }
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "id", "x", "y", "w", "h"],
              "properties": {
                "type": { "type": "string", "enum": ["text", "shape", "image", "table", "line", "chart", "icon", "diagram", "cropped-asset"] },
                "id": { "type": "string" },
                "semanticParentId": { "$ref": "#/$defs/nonEmptyString" },
                "assetId": { "$ref": "#/$defs/nonEmptyString" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "w": { "type": "number" },
                "h": { "type": "number" },
                "role": { "type": "string" },
                "connector": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceId", "targetId", "sourceAnchor", "targetAnchor", "route"],
                  "properties": {
                    "sourceId": { "type": "string", "minLength": 1 },
                    "targetId": { "type": "string", "minLength": 1 },
                    "sourceAnchor": { "type": "string", "enum": ["auto", "top", "right", "bottom", "left"] },
                    "targetAnchor": { "type": "string", "enum": ["auto", "top", "right", "bottom", "left"] },
                    "route": { "type": "string", "enum": ["straight", "orthogonal"] }
                  }
                },
                "text": { "type": "string" },
                "shape": { "type": "string", "enum": ["rect", "roundRect", "ellipse"] },
                "imageShape": { "type": "string", "enum": ["rect", "roundRect", "ellipse"] },
                "rounding": { "type": "boolean" },
                "src": { "type": "string" },
                "alt": { "type": "string" },
                "altText": { "type": "string" },
                "focalPoint": { "$ref": "#/$defs/focalPoint" },
                "cropPolicy": { "$ref": "#/$defs/cropPolicy" },
                "sizing": { "$ref": "#/$defs/sizing" },
                "headers": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array" },
                "kind": {
                  "type": "string",
                  "enum": [
                    "bar",
                    "line",
                    "pie",
                    "stackedBar",
                    "horizontalBar",
                    "groupedBar",
                    "kpiGroup",
                    "sparkline",
                    "layeredArchitecture",
                    "compilerPipeline",
                    "capabilityStack",
                    "swimlane",
                    "matrixMap"
                  ]
                },
                "name": { "type": "string", "enum": ["check", "x", "info", "arrow-right"] },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label"],
                    "properties": {
                      "label": { "type": "string" },
                      "value": { "type": "number" },
                      "series": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": { "type": "number" }
                      },
                      "color": { "type": "string" }
                    },
                    "anyOf": [
                      { "required": ["value"] },
                      { "required": ["series"] }
                    ]
                  }
                },
                "style": { "type": "object" },
                "layers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "nodes"],
                    "properties": {
                      "label": { "type": "string" },
                      "nodes": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "lanes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "nodes"],
                    "properties": {
                      "label": { "type": "string" },
                      "nodes": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "columns": { "type": "array", "items": { "type": "string" } }
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "line" } }, "required": ["type"] },
                  "then": { "not": { "properties": { "w": { "const": 0 }, "h": { "const": 0 } }, "required": ["w", "h"] } },
                  "else": { "properties": { "w": { "exclusiveMinimum": 0 }, "h": { "exclusiveMinimum": 0 } } }
                }
              ]
            }
          }
        }
      }
    }
  }
}
