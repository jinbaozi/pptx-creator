{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-creator.local/text-fit-report.schema.json",
  "title": "Text Fit Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "status", "summary", "slides"],
  "properties": {
    "version": { "const": "0.1.0" },
    "source": { "type": "string", "enum": ["fontkit", "heuristic", "unavailable"] },
    "status": { "type": "string", "enum": ["passed", "failed", "unavailable"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "overflowCount"],
      "properties": {
        "checked": { "type": "integer", "minimum": 0 },
        "overflowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "elements"],
        "properties": {
          "slideId": { "type": "string" },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["elementId", "status", "box", "fontSize", "minimumFontSize", "lineCount", "requiredHeight", "availableWidth", "availableHeight", "overflowBy", "suggestedFontSize"],
              "properties": {
                "elementId": { "type": "string" },
                "status": { "type": "string", "enum": ["fits", "resize-required", "font-reduction-required", "content-reflow-required"] },
                "box": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": { "type": "number" }, "y": { "type": "number" },
                    "w": { "type": "number" }, "h": { "type": "number" }
                  }
                },
                "fontSize": { "type": "number", "exclusiveMinimum": 0 },
                "minimumFontSize": { "type": "number", "exclusiveMinimum": 0 },
                "lineCount": { "type": "integer", "minimum": 1 },
                "requiredHeight": { "type": "number", "minimum": 0 },
                "availableWidth": { "type": "number", "minimum": 0 },
                "availableHeight": { "type": "number", "minimum": 0 },
                "overflowBy": { "type": "number", "minimum": 0 },
                "suggestedFontSize": { "type": "number", "minimum": 0 },
                "suggestion": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "reason": { "type": "string" }
  }
}
