{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinbaozi/pptx-creator/skills/text-to-html/schemas/presentation-plan/2.0.0",
  "title": "Text to HTML presentation plan 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "deck", "brief", "assumptions", "narrative", "designIntent", "pagination", "sources", "assets", "slides", "review"],
  "properties": {
    "version": { "const": "2.0.0" },
    "deck": { "$ref": "#/$defs/deck" },
    "brief": { "$ref": "#/$defs/brief" },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "narrative": { "$ref": "#/$defs/narrative" },
    "designIntent": { "$ref": "#/$defs/designIntent" },
    "pagination": { "$ref": "#/$defs/pagination" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } },
    "review": { "$ref": "#/$defs/review" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 240 },
    "factStatus": { "enum": ["provided", "verified", "inferred", "unverified", "placeholder"] },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "size"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "language": { "type": "string", "minLength": 2, "maxLength": 20 },
        "size": { "const": { "width": 1280, "height": 720, "unit": "px" } }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "familiarity", "decisionAuthority"],
      "properties": {
        "description": { "$ref": "#/$defs/shortText" },
        "familiarity": { "enum": ["new", "mixed", "expert"] },
        "decisionAuthority": { "enum": ["informed", "influencer", "decision-maker"] }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "scenario", "device", "deliveryMode", "durationMinutes", "desiredAction", "networkPolicy", "quietConstraints", "brandConstraints", "confidentiality", "languageRegion", "accessibility"],
      "properties": {
        "audience": { "$ref": "#/$defs/audience" },
        "scenario": { "$ref": "#/$defs/shortText" },
        "device": { "$ref": "#/$defs/shortText" },
        "deliveryMode": { "$ref": "#/$defs/shortText" },
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "desiredAction": { "$ref": "#/$defs/shortText" },
        "networkPolicy": { "enum": ["offline", "prefer", "require"] },
        "quietConstraints": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
        "brandConstraints": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
        "confidentiality": { "enum": ["public", "internal", "confidential"] },
        "languageRegion": { "$ref": "#/$defs/shortText" },
        "accessibility": { "type": "array", "items": { "$ref": "#/$defs/shortText" } }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "impact", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/shortText" },
        "impact": { "enum": ["low", "medium", "high"] },
        "status": { "enum": ["inferred", "confirmed", "rejected"] }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "text", "slideIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["opening", "context", "tension", "evidence", "turn", "climax", "resolution", "action"] },
        "text": { "$ref": "#/$defs/shortText" },
        "slideIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "beatIds", "slideIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/shortText" },
        "beatIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "slideIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "attentionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideId", "level"],
      "properties": {
        "slideId": { "$ref": "#/$defs/id" },
        "level": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "thesis", "chapters", "beats", "titleChain", "attentionCurve"],
      "properties": {
        "framework": { "$ref": "#/$defs/shortText" },
        "thesis": { "type": "string", "minLength": 1, "maxLength": 360 },
        "chapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chapter" } },
        "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } },
        "titleChain": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shortText" } },
        "attentionCurve": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attentionPoint" } }
      }
    },
    "fontStack": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?=.*[A-Za-z0-9\\u00C0-\\uFFFF])[A-Za-z0-9\\u00C0-\\uFFFF .,'\"-]+$" },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "fontOverrides": { "type": "object", "additionalProperties": false, "properties": { "display": { "$ref": "#/$defs/fontStack" }, "body": { "$ref": "#/$defs/fontStack" } } },
    "colorOverrides": { "type": "object", "additionalProperties": false, "properties": { "background": { "$ref": "#/$defs/hexColor" }, "surface": { "$ref": "#/$defs/hexColor" }, "text": { "$ref": "#/$defs/hexColor" }, "muted": { "$ref": "#/$defs/hexColor" }, "primary": { "$ref": "#/$defs/hexColor" }, "primarySoft": { "$ref": "#/$defs/hexColor" }, "accent": { "$ref": "#/$defs/hexColor" }, "positive": { "$ref": "#/$defs/hexColor" }, "border": { "$ref": "#/$defs/hexColor" } } },
    "typeOverrides": { "type": "object", "additionalProperties": false, "properties": { "display": { "type": "number", "minimum": 38, "maximum": 96 }, "title": { "type": "number", "minimum": 38, "maximum": 96 }, "section": { "type": "number", "minimum": 24, "maximum": 72 }, "body": { "type": "number", "minimum": 22, "maximum": 48 }, "label": { "type": "number", "minimum": 15, "maximum": 32 }, "source": { "type": "number", "minimum": 12, "maximum": 24 } } },
    "spaceOverrides": { "type": "object", "additionalProperties": false, "properties": { "canvasX": { "type": "number", "minimum": 48, "maximum": 144 }, "canvasY": { "type": "number", "minimum": 40, "maximum": 96 }, "gap": { "type": "number", "minimum": 8, "maximum": 64 }, "small": { "type": "number", "minimum": 4, "maximum": 32 } } },
    "radiusOverrides": { "type": "object", "additionalProperties": false, "properties": { "card": { "type": "number", "minimum": 0, "maximum": 40 }, "pill": { "type": "number", "minimum": 12, "maximum": 999 } } },
    "boxShadow": { "type": "string", "maxLength": 120, "pattern": "^(?:none|(?:0|-?[0-9]+(?:\\.[0-9]+)?px)(?:\\s+(?:0|-?[0-9]+(?:\\.[0-9]+)?px)){2,3}\\s+(?:#[0-9A-Fa-f]{6}|rgba?\\([0-9.]+,\\s*[0-9.]+,\\s*[0-9.]+(?:,\\s*(?:0|0?\\.[0-9]+|1))?\\)))$" },
    "shadowOverrides": { "type": "object", "additionalProperties": false, "properties": { "card": { "$ref": "#/$defs/boxShadow" } } },
    "tokenOverrides": { "type": "object", "additionalProperties": false, "properties": { "fonts": { "$ref": "#/$defs/fontOverrides" }, "colors": { "$ref": "#/$defs/colorOverrides" }, "type": { "$ref": "#/$defs/typeOverrides" }, "space": { "$ref": "#/$defs/spaceOverrides" }, "radius": { "$ref": "#/$defs/radiusOverrides" }, "shadow": { "$ref": "#/$defs/shadowOverrides" } } },
    "designLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalPlanSha256", "themeManifestSha256", "tokenSha256", "archetypeRegistrySha256", "assetLockSha256", "rendererVersion"],
      "properties": {
        "canonicalPlanSha256": { "$ref": "#/$defs/sha256" },
        "themeManifestSha256": { "$ref": "#/$defs/sha256" },
        "tokenSha256": { "$ref": "#/$defs/sha256" },
        "archetypeRegistrySha256": { "$ref": "#/$defs/sha256" },
        "assetLockSha256": { "$ref": "#/$defs/sha256" },
        "rendererVersion": { "$ref": "#/$defs/shortText" }
      }
    },
    "designIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition", "counterProposition", "mood", "referenceSignals", "themeId", "compositionDiversity", "motionIntensity", "informationDensity", "imageryStrategy", "allowedTechniques", "forbiddenTechniques", "tokenOverrides", "lock"],
      "properties": {
        "proposition": { "$ref": "#/$defs/shortText" },
        "counterProposition": { "$ref": "#/$defs/shortText" },
        "mood": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shortText" } },
        "referenceSignals": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
        "themeId": { "$ref": "#/$defs/id" },
        "compositionDiversity": { "enum": ["low", "medium", "high"] },
        "motionIntensity": { "enum": ["none", "subtle", "expressive"] },
        "informationDensity": { "enum": ["sparse", "balanced", "dense"] },
        "imageryStrategy": { "$ref": "#/$defs/shortText" },
        "allowedTechniques": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
        "forbiddenTechniques": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
        "tokenOverrides": { "$ref": "#/$defs/tokenOverrides" },
        "lock": { "$ref": "#/$defs/designLock" }
      }
    },
    "pageBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideId", "maxWords", "maxPrimarySupports", "timeSeconds", "mustKeepTogether", "canSplit", "notesOnly"],
      "properties": {
        "slideId": { "$ref": "#/$defs/id" },
        "maxWords": { "type": "integer", "minimum": 1, "maximum": 400 },
        "maxPrimarySupports": { "type": "integer", "minimum": 0, "maximum": 5 },
        "timeSeconds": { "type": "integer", "minimum": 1, "maximum": 1200 },
        "mustKeepTogether": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "canSplit": { "type": "boolean" },
        "semanticBreak": { "type": "string", "minLength": 1, "maxLength": 240 },
        "continuationOf": { "$ref": "#/$defs/id" },
        "notesOnly": { "type": "array", "items": { "$ref": "#/$defs/shortText" } }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageBudgets"],
      "properties": { "pageBudgets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pageBudget" } } }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "factStatus", "sourceRefs"],
      "properties": {
        "text": { "$ref": "#/$defs/shortText" },
        "factStatus": { "$ref": "#/$defs/factStatus" },
        "sourceRefs": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "factStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["user-input", "file", "url", "assumption", "placeholder"] },
        "label": { "$ref": "#/$defs/shortText" },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "factStatus": { "$ref": "#/$defs/factStatus" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "spdx", "licenseUrl", "attribution"],
      "properties": {
        "status": { "enum": ["user-provided", "project-owned", "licensed", "public-domain", "unknown"] },
        "spdx": { "type": "string", "minLength": 1, "maxLength": 100 },
        "licenseUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "attribution": { "$ref": "#/$defs/shortText" }
      }
    },
    "assetFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedLocator", "reason"],
      "properties": { "selectedLocator": { "type": "string", "minLength": 1, "maxLength": 1000 }, "reason": { "$ref": "#/$defs/shortText" } }
    },
    "focalPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selectedLocator", "intendedPurpose", "mime", "rights", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "selectedLocator": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "intendedPurpose": { "$ref": "#/$defs/shortText" },
        "mime": { "type": "string", "minLength": 3, "maxLength": 120 },
        "rights": { "$ref": "#/$defs/rights" },
        "alt": { "$ref": "#/$defs/shortText" },
        "objectFit": { "enum": ["contain", "cover"] },
        "focalPoint": { "$ref": "#/$defs/focalPoint" },
        "sourceRef": { "$ref": "#/$defs/id" },
        "expectedSha256": { "$ref": "#/$defs/sha256" },
        "fallback": { "$ref": "#/$defs/assetFallback" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "points"],
      "properties": { "label": { "$ref": "#/$defs/shortText" }, "points": { "type": "array", "items": { "$ref": "#/$defs/claim" } } }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "claim"],
      "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 28 }, "label": { "$ref": "#/$defs/shortText" }, "detail": { "$ref": "#/$defs/shortText" }, "claim": { "$ref": "#/$defs/claim" } }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "claim"],
      "properties": { "label": { "$ref": "#/$defs/shortText" }, "claim": { "$ref": "#/$defs/claim" } }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "label", "claim"],
      "properties": { "when": { "$ref": "#/$defs/shortText" }, "label": { "$ref": "#/$defs/shortText" }, "claim": { "$ref": "#/$defs/claim" } }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/shortText" } },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "values"],
            "properties": {
              "label": { "$ref": "#/$defs/shortText" },
              "values": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/claim" } }
            }
          }
        }
      }
    },
    "chartPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "claim"],
      "properties": {
        "label": { "$ref": "#/$defs/shortText" },
        "value": { "type": "number" },
        "series": { "type": "object", "minProperties": 1, "maxProperties": 6, "additionalProperties": { "type": "number" } },
        "claim": { "$ref": "#/$defs/claim" }
      },
      "oneOf": [
        { "required": ["value"], "properties": { "value": { "type": "number" } }, "not": { "required": ["series"], "properties": { "series": {} } } },
        { "required": ["series"], "properties": { "series": { "type": "object" } }, "not": { "required": ["value"], "properties": { "value": {} } } }
      ]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "enum": ["stackedBar", "groupedBar", "horizontalBar", "kpiGroup", "sparkline"] },
        "data": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/chartPoint" } }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtitle": { "$ref": "#/$defs/shortText" },
        "statement": { "$ref": "#/$defs/claim" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "left": { "$ref": "#/$defs/group" },
        "right": { "$ref": "#/$defs/group" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
        "quote": { "$ref": "#/$defs/claim" },
        "attribution": { "$ref": "#/$defs/shortText" },
        "assetId": { "$ref": "#/$defs/id" },
        "caption": { "$ref": "#/$defs/claim" },
        "table": { "$ref": "#/$defs/table" },
        "chart": { "$ref": "#/$defs/chart" },
        "action": { "$ref": "#/$defs/claim" },
        "summary": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRefs", "assetRefs"],
      "properties": {
        "sourceRefs": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/id" } },
        "assetRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "intent", "layoutArchetype", "title", "takeaway", "focalPoint", "hierarchy", "visualRole", "speakerNotes", "transitionPurpose", "evidence", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "intent": { "enum": ["cover", "statement", "bullets", "comparison", "metrics", "process", "timeline", "quote", "image", "closing", "section-break", "hero-statement", "executive-summary", "editorial-split", "evidence-image", "metric-focus", "dashboard", "comparison-matrix", "process-flow", "timeline-roadmap", "quote-story", "table-chart-diagram", "closing-action"] },
        "layoutArchetype": { "enum": ["cover", "statement", "bullets", "comparison", "metrics", "process", "timeline", "quote", "image", "closing", "section-break", "hero-statement", "executive-summary", "editorial-split", "evidence-image", "metric-focus", "dashboard", "comparison-matrix", "process-flow", "timeline-roadmap", "quote-story", "table-chart-diagram", "closing-action"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "takeaway": { "type": "string", "minLength": 1, "maxLength": 260 },
        "focalPoint": { "$ref": "#/$defs/shortText" },
        "hierarchy": { "enum": ["title-first", "visual-first", "evidence-first", "action-first"] },
        "visualRole": { "$ref": "#/$defs/shortText" },
        "speakerNotes": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "transitionPurpose": { "$ref": "#/$defs/shortText" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "slots": { "$ref": "#/$defs/slots" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactHashes"],
      "properties": {
        "status": { "enum": ["required", "approved", "rejected"] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "artifactHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["designIntent", "assetLock", "renderer"],
          "properties": { "designIntent": { "$ref": "#/$defs/sha256" }, "assetLock": { "$ref": "#/$defs/sha256" }, "renderer": { "$ref": "#/$defs/sha256" } }
        },
        "invalidatedBy": { "type": "array", "items": { "$ref": "#/$defs/shortText" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "design", "rights"],
      "properties": { "content": { "$ref": "#/$defs/approval" }, "design": { "$ref": "#/$defs/approval" }, "rights": { "$ref": "#/$defs/approval" } }
    }
  }
}
