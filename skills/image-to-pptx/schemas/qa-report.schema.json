{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinbaozi/pptx-creator/skills/image-to-pptx/schemas/qa-report/1.0.0",
  "title": "Image to PPTX quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "gate",
    "thresholds",
    "slideCount",
    "attemptsUsed",
    "maxRepairAttempts",
    "visual",
    "editability",
    "repairHistory",
    "degradations",
    "findings",
    "artifacts"
  ],
  "properties": {
    "version": { "const": "1.0.0" },
    "status": { "enum": ["passed", "failed"] },
    "gate": { "const": "image-native-reconstruction" },
    "thresholds": { "type": "object" },
    "slideCount": { "type": "integer", "minimum": 1 },
    "attemptsUsed": { "type": "integer", "minimum": 0, "maximum": 3 },
    "maxRepairAttempts": { "type": "integer", "minimum": 0, "maximum": 3 },
    "visual": { "type": "object" },
    "editability": { "type": "object" },
    "repairHistory": { "type": "array", "minItems": 1, "maxItems": 4 },
    "degradations": { "type": "array" },
    "findings": { "type": "array" },
    "artifacts": { "type": "object" }
  }
}
