{
  "name": "@pptx-creator/image-to-pptx-skill",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/image-to-pptx.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs tests/contract.test.mjs tests/error.test.mjs",
    "test:py": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "test:visual": "IMAGE_TO_PPTX_VISUAL=1 node --test tests/visual.test.mjs",
    "test:isolation": "IMAGE_TO_PPTX_ISOLATION=1 node --test tests/isolation.test.mjs",
    "example:min": "node scripts/run_minimal_example.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jszip": "3.10.1",
    "pptxgenjs": "3.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
