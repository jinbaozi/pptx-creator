{
  "version": "0.1.0",
  "id": "radial-system",
  "whenToUse": ["Several relationships orbit one central system or decision."],
  "notFor": ["Strictly sequential processes."],
  "pageRoles": ["evidence", "process", "architecture"],
  "contentShape": { "requiredSlots": ["headline", "primary", "accent"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.5, "max": 1 },
    "visualDensity": { "min": 0.25, "max": 0.8 },
    "visualEnergy": { "min": 0.35, "max": 1 }
  },
  "assetRequirements": { "required": false, "kinds": ["diagram-source"], "role": "Optional relationship source", "min": 0, "max": 1 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider", "native-connector"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Decorative orbit lines", "More nodes than can be labeled legibly"],
  "contentLimits": { "headlineChars": 64, "bodyChars": 460, "maxItems": 6 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.lg}", "inlineEnd": "{spacing.lg}", "blockEnd": "{spacing.lg}", "inlineStart": "{spacing.lg}" },
    "child": {
      "primitive": "overlay",
      "children": [
        { "slot": "primary" },
        { "primitive": "anchor", "anchor": "top", "size": "compact", "inset": "{spacing.sm}", "child": { "slot": "headline" } },
        { "primitive": "anchor", "anchor": "center", "size": "medium", "inset": "{spacing.lg}", "child": { "slot": "accent" } }
      ]
    }
  },
  "fixtures": [{ "id": "system-orbit", "slots": { "headline": "One system coordinates the edges", "primary": ["Signal", "Policy", "Service", "Feedback"], "accent": "Core" } }]
}
