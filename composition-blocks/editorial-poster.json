{
  "version": "0.1.0",
  "id": "editorial-poster",
  "whenToUse": ["A decisive message needs poster-scale hierarchy and one controlled accent."],
  "notFor": ["Dense data tables or multi-step technical procedures."],
  "pageRoles": ["cover", "section", "single-point", "closing"],
  "contentShape": { "requiredSlots": ["headline", "primary", "accent"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.45, "max": 1 },
    "visualDensity": { "min": 0.1, "max": 0.7 },
    "visualEnergy": { "min": 0.35, "max": 1 }
  },
  "assetRequirements": { "required": false, "kinds": [], "role": "No external asset required", "min": 0, "max": 0 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Equal-weight card grids", "Decorative texture behind the headline"],
  "contentLimits": { "headlineChars": 64, "bodyChars": 240, "maxItems": 3 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.lg}", "inlineEnd": "{spacing.lg}", "blockEnd": "{spacing.lg}", "inlineStart": "{spacing.lg}" },
    "child": {
      "primitive": "split",
      "direction": "vertical",
      "ratios": [1, 3],
      "gap": "{spacing.md}",
      "children": [
        { "slot": "headline" },
        {
          "primitive": "overlay",
          "children": [
            { "slot": "primary" },
            { "primitive": "anchor", "anchor": "bottom-right", "size": "compact", "inset": "{spacing.sm}", "child": { "slot": "accent" } }
          ]
        }
      ]
    }
  },
  "fixtures": [{ "id": "poster-message", "slots": { "headline": "One decision changes the trajectory", "primary": "Frame the evidence, then make the next move explicit.", "accent": "01" } }]
}
