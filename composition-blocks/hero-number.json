{
  "version": "0.1.0",
  "id": "hero-number",
  "whenToUse": ["One verified metric should dominate the decision frame."],
  "notFor": ["Slides without a trustworthy quantitative signal."],
  "pageRoles": ["single-point", "evidence", "data", "decision"],
  "contentShape": { "requiredSlots": ["headline", "metric", "supporting"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.3, "max": 0.9 },
    "visualDensity": { "min": 0.1, "max": 0.65 },
    "visualEnergy": { "min": 0.35, "max": 1 }
  },
  "assetRequirements": { "required": false, "kinds": ["chart-data"], "role": "Optional verified metric source", "min": 0, "max": 1 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Unverified vanity metric", "Multiple competing hero values"],
  "contentLimits": { "headlineChars": 64, "bodyChars": 220, "maxItems": 3 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.xl}", "inlineEnd": "{spacing.xl}", "blockEnd": "{spacing.xl}", "inlineStart": "{spacing.xl}" },
    "child": {
      "primitive": "split",
      "direction": "horizontal",
      "ratios": [2, 1],
      "gap": "{spacing.lg}",
      "children": [
        { "primitive": "stack", "direction": "vertical", "gap": "{spacing.md}", "weights": [1, 2], "children": [{ "slot": "headline" }, { "slot": "supporting" }] },
        { "primitive": "anchor", "anchor": "center", "size": "full", "inset": "{spacing.sm}", "child": { "slot": "metric" } }
      ]
    }
  },
  "fixtures": [{ "id": "metric-decision", "slots": { "headline": "The adoption gap is closing", "metric": "72%", "supporting": "Verified against the current reporting period" } }]
}
