{
  "version": "0.1.0",
  "id": "full-bleed-media",
  "whenToUse": ["A localized, rights-cleared visual carries the main evidence or atmosphere."],
  "notFor": ["Slides without a meaningful visual asset."],
  "pageRoles": ["cover", "section", "evidence", "case-study", "closing"],
  "contentShape": { "requiredSlots": ["headline", "media", "accent"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.4, "max": 1 },
    "visualDensity": { "min": 0.05, "max": 0.65 },
    "visualEnergy": { "min": 0.4, "max": 1 }
  },
  "assetRequirements": { "required": true, "kinds": ["photo", "illustration", "texture"], "role": "Hero visual evidence", "min": 1, "max": 1 },
  "editability": { "minimumLevel": 4, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "native-transparency", "crop"],
  "fallback": { "mode": "block", "blockId": "minimal-statement", "when": ["missing-assets", "unsupported-content"] },
  "antiPatterns": ["Decorative stock photography", "Rasterized text baked into the image"],
  "contentLimits": { "headlineChars": 56, "bodyChars": 160, "maxItems": 2 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.xs}", "inlineEnd": "{spacing.xs}", "blockEnd": "{spacing.xs}", "inlineStart": "{spacing.xs}" },
    "child": {
      "primitive": "overlay",
      "children": [
        { "slot": "media" },
        { "primitive": "anchor", "anchor": "bottom-left", "size": "medium", "inset": "{spacing.md}", "child": { "slot": "headline" } },
        { "primitive": "anchor", "anchor": "top-right", "size": "compact", "inset": "{spacing.sm}", "child": { "slot": "accent" } }
      ]
    }
  },
  "fixtures": [{ "id": "media-hero", "assetId": "fixture-full-bleed-media-hero", "slots": { "headline": "The operating context is visible", "media": "Native media fallback placeholder", "accent": "Evidence" } }]
}
