{
  "version": "0.1.0",
  "id": "bento-asymmetric",
  "whenToUse": ["Several content types need a coherent dashboard without equal-weight repetition."],
  "notFor": ["A single message that needs maximum whitespace."],
  "pageRoles": ["evidence", "data", "comparison", "architecture"],
  "contentShape": { "requiredSlots": ["headline", "primary", "supporting", "accent"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.4, "max": 1 },
    "visualDensity": { "min": 0.45, "max": 1 },
    "visualEnergy": { "min": 0.2, "max": 0.9 }
  },
  "assetRequirements": { "required": false, "kinds": ["chart-data", "diagram-source", "icon"], "role": "Optional structured evidence", "min": 0, "max": 3 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Uniform card soup", "More than one hero region"],
  "contentLimits": { "headlineChars": 64, "bodyChars": 720, "maxItems": 8 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.lg}", "inlineEnd": "{spacing.lg}", "blockEnd": "{spacing.lg}", "inlineStart": "{spacing.lg}" },
    "child": {
      "primitive": "split",
      "direction": "horizontal",
      "ratios": [1, 2],
      "gap": "{spacing.md}",
      "children": [
        { "primitive": "stack", "direction": "vertical", "gap": "{spacing.lg}", "weights": [2, 1], "children": [{ "slot": "headline" }, { "slot": "accent" }] },
        { "primitive": "stack", "direction": "vertical", "gap": "{spacing.sm}", "weights": [2, 1], "children": [{ "slot": "primary" }, { "slot": "supporting" }] }
      ]
    }
  },
  "fixtures": [{ "id": "asymmetric-bento", "slots": { "headline": "System health at a glance", "primary": ["Core signal", "Trend", "Outcome"], "supporting": "Context and caveat", "accent": "Priority" } }]
}
