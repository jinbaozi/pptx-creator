{
  "version": "0.1.0",
  "id": "minimal-statement",
  "whenToUse": ["One message and one supporting thought need maximum clarity."],
  "notFor": ["Dense evidence, multi-axis comparison, or asset-led explanation."],
  "pageRoles": ["cover", "section", "single-point", "evidence", "data", "comparison", "process", "architecture", "case-study", "quote", "decision", "closing", "appendix"],
  "contentShape": { "requiredSlots": ["headline"], "optionalSlots": ["primary"] },
  "dialRange": {
    "compositionVariance": { "min": 0, "max": 1 },
    "visualDensity": { "min": 0, "max": 1 },
    "visualEnergy": { "min": 0, "max": 1 }
  },
  "assetRequirements": { "required": false, "kinds": [], "role": "No external asset required", "min": 0, "max": 0 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["missing-assets", "content-overflow", "unsupported-content"] },
  "antiPatterns": ["Filler cards", "Decorative imagery without evidence value"],
  "contentLimits": { "headlineChars": 72, "bodyChars": 320, "maxItems": 4 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.xl}", "inlineEnd": "{spacing.xl}", "blockEnd": "{spacing.xl}", "inlineStart": "{spacing.xl}" },
    "child": {
      "primitive": "stack",
      "direction": "vertical",
      "gap": "{spacing.md}",
      "weights": [1, 3],
      "children": [{ "slot": "headline" }, { "slot": "primary" }]
    }
  },
  "fixtures": [{ "id": "one-message", "slots": { "headline": "Clarity is the design decision", "primary": "Keep the proof native, editable, and easy to scan." } }]
}
