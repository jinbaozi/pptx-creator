{
  "version": "0.1.0",
  "id": "asymmetric-split",
  "whenToUse": ["A primary argument needs a smaller counterpoint or qualification."],
  "notFor": ["Perfectly symmetrical option comparisons."],
  "pageRoles": ["single-point", "evidence", "comparison", "decision"],
  "contentShape": { "requiredSlots": ["headline", "primary", "supporting"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.35, "max": 1 },
    "visualDensity": { "min": 0.25, "max": 0.85 },
    "visualEnergy": { "min": 0.2, "max": 0.85 }
  },
  "assetRequirements": { "required": false, "kinds": [], "role": "No external asset required", "min": 0, "max": 0 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Two equal columns", "Unrelated supporting content"],
  "contentLimits": { "headlineChars": 72, "bodyChars": 520, "maxItems": 6 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.lg}", "inlineEnd": "{spacing.lg}", "blockEnd": "{spacing.lg}", "inlineStart": "{spacing.lg}" },
    "child": {
      "primitive": "stack",
      "direction": "vertical",
      "gap": "{spacing.md}",
      "weights": [1, 4],
      "children": [
        { "slot": "headline" },
        { "primitive": "split", "direction": "horizontal", "ratios": [1.7, 1], "gap": "{spacing.lg}", "children": [{ "slot": "primary" }, { "slot": "supporting" }] }
      ]
    }
  },
  "fixtures": [{ "id": "weighted-argument", "slots": { "headline": "Lead with the strongest evidence", "primary": ["Primary finding", "Material implication"], "supporting": "Constraint and context" } }]
}
