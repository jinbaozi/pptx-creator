{
  "version": "0.1.0",
  "id": "chart-dominant",
  "whenToUse": ["A chart or native data structure is the primary proof and one metric needs emphasis."],
  "notFor": ["Data-free opinion slides."],
  "pageRoles": ["evidence", "data", "decision"],
  "contentShape": { "requiredSlots": ["headline", "primary", "metric"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.2, "max": 0.85 },
    "visualDensity": { "min": 0.45, "max": 1 },
    "visualEnergy": { "min": 0.15, "max": 0.85 }
  },
  "assetRequirements": { "required": false, "kinds": ["chart-data"], "role": "Optional localized chart data", "min": 0, "max": 1 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Chart as decoration", "Legend competing with the core trend"],
  "contentLimits": { "headlineChars": 68, "bodyChars": 420, "maxItems": 8 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.lg}", "inlineEnd": "{spacing.lg}", "blockEnd": "{spacing.lg}", "inlineStart": "{spacing.lg}" },
    "child": {
      "primitive": "stack",
      "direction": "vertical",
      "gap": "{spacing.md}",
      "weights": [1, 4],
      "children": [
        { "slot": "headline" },
        {
          "primitive": "overlay",
          "children": [
            { "slot": "primary" },
            { "primitive": "anchor", "anchor": "top-right", "size": "compact", "inset": "{spacing.md}", "child": { "slot": "metric" } }
          ]
        }
      ]
    }
  },
  "fixtures": [{ "id": "trend-proof", "slots": { "headline": "The trend is structurally different", "primary": ["Q1 42", "Q2 56", "Q3 72"], "metric": "+30" } }]
}
