{
  "version": "0.1.0",
  "id": "annotated-media",
  "whenToUse": ["A visual needs an adjacent explanation rather than decorative captioning."],
  "notFor": ["Slides without a localized visual asset."],
  "pageRoles": ["cover", "evidence", "case-study", "appendix"],
  "contentShape": { "requiredSlots": ["headline", "media", "supporting"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.35, "max": 1 },
    "visualDensity": { "min": 0.2, "max": 0.85 },
    "visualEnergy": { "min": 0.25, "max": 0.95 }
  },
  "assetRequirements": { "required": true, "kinds": ["photo", "illustration"], "role": "Annotated visual evidence", "min": 1, "max": 1 },
  "editability": { "minimumLevel": 4, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "native-transparency", "crop", "divider"],
  "fallback": { "mode": "block", "blockId": "minimal-statement", "when": ["missing-assets", "unsupported-content"] },
  "antiPatterns": ["Text baked into the source image", "Annotations without a visible referent"],
  "contentLimits": { "headlineChars": 60, "bodyChars": 360, "maxItems": 5 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.md}", "inlineEnd": "{spacing.md}", "blockEnd": "{spacing.md}", "inlineStart": "{spacing.md}" },
    "child": {
      "primitive": "split",
      "direction": "horizontal",
      "ratios": [3, 1],
      "gap": "{spacing.lg}",
      "children": [
        {
          "primitive": "overlay",
          "children": [
            { "slot": "media" },
            { "primitive": "anchor", "anchor": "bottom-left", "size": "compact", "inset": "{spacing.sm}", "child": { "slot": "headline" } }
          ]
        },
        { "slot": "supporting" }
      ]
    }
  },
  "fixtures": [{ "id": "visual-annotation", "assetId": "fixture-annotated-media-visual", "slots": { "headline": "Observe the boundary", "media": "Native media fallback placeholder", "supporting": ["What to notice", "Why it matters", "Source context"] } }]
}
