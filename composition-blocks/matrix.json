{
  "version": "0.1.0",
  "id": "matrix",
  "whenToUse": ["Several options require a stable two-dimensional decision frame."],
  "notFor": ["Linear stories or a single dominant metric."],
  "pageRoles": ["data", "comparison", "decision", "appendix"],
  "contentShape": { "requiredSlots": ["headline", "primary", "supporting", "accent"], "optionalSlots": [] },
  "dialRange": {
    "compositionVariance": { "min": 0.15, "max": 0.75 },
    "visualDensity": { "min": 0.4, "max": 1 },
    "visualEnergy": { "min": 0.1, "max": 0.7 }
  },
  "assetRequirements": { "required": false, "kinds": ["chart-data", "diagram-source"], "role": "Optional matrix source", "min": 0, "max": 1 },
  "editability": { "minimumLevel": 5, "nativeText": true, "nativeVisual": true, "fullSlideRaster": false },
  "pptSafeEffects": ["solid-fill", "thin-border", "divider"],
  "fallback": { "mode": "native-family", "when": ["content-overflow", "unsupported-content"] },
  "antiPatterns": ["Arbitrary axes", "More than four unlabeled decision regions"],
  "contentLimits": { "headlineChars": 64, "bodyChars": 620, "maxItems": 8 },
  "topology": {
    "primitive": "safe-area",
    "insets": { "blockStart": "{spacing.lg}", "inlineEnd": "{spacing.lg}", "blockEnd": "{spacing.lg}", "inlineStart": "{spacing.lg}" },
    "child": {
      "primitive": "stack",
      "direction": "vertical",
      "gap": "{spacing.md}",
      "weights": [1, 4],
      "children": [
        { "slot": "headline" },
        { "primitive": "grid", "columns": 2, "columnGap": "{spacing.md}", "rowGap": "{spacing.md}", "children": [{ "slot": "primary" }, { "slot": "supporting" }, { "slot": "accent" }] }
      ]
    }
  },
  "fixtures": [{ "id": "decision-matrix", "slots": { "headline": "Prioritize by impact and effort", "primary": "Accelerate", "supporting": "Explore", "accent": "Maintain" } }]
}
