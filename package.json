{
  "name": "pptx-creator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pptx": "node scripts/pptx.mjs",
    "test": "npm run test:unit",
    "test:unit": "PLAYWRIGHT_RUN=0 vitest run --exclude tests/visual-regression.test.mjs",
    "test:browser": "PLAYWRIGHT_RUN=1 vitest run tests/html-layout-safety.test.mjs tests/html-measurement.test.mjs",
    "test:visual": "vitest run tests/visual-regression.test.mjs",
    "test:py": "node scripts/run-python.mjs -m unittest discover -s tests -p \"*_test.py\"",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "fontkit": "^2.0.0",
    "jszip": "^3.10.1",
    "node-html-parser": "^6.1.13",
    "pptxgenjs": "^3.12.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "playwright": "^1.52.0",
    "vitest": "^1.6.0"
  }
}
